<Project Sdk="Godot.NET.Sdk/4.5.1">
  <Import Project="Sts2PathDiscovery.props" />
  <Import Project="local.props" Condition="Exists('local.props')" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Workshop 单 DLL 需跨 Win / macOS / Linux 加载；勿 publish -r win-x64 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <PackageReference Include="STS2.RitsuLib" Version="0.5.18" />
  </ItemGroup>

  <PropertyGroup>
    <_Sts2GameVersion>0.107.1</_Sts2GameVersion>
  </PropertyGroup>

  <Target Name="ValidateSts2References" BeforeTargets="CoreCompile">
    <Error
      Condition="!Exists('$(Sts2DataDir)/sts2.dll')"
      Text="sts2.dll not found at '$(Sts2DataDir)'. Install Slay the Spire 2 or set Sts2Dir / Sts2DataDir in local.props (see local.props.example)." />

  </Target>

  <!--
    只复制 manifest + dll + pck。勿把 TheQueen/ 整包复制到 mods 下：
    ModManager 会递归扫描子目录里所有 .json 并当作 manifest，localization 会刷屏 ERROR。
    资源应打进 TheQueen.pck（res://TheQueen/...）。
  -->
  <Target Name="Copy Mod" AfterTargets="PostBuildEvent" Condition="Exists('$(Sts2DataDir)/sts2.dll')">
    <PropertyGroup>
      <_ModDir>$(Sts2Dir)/mods/$(MSBuildProjectName)</_ModDir>
      <_ModLibDir>$(_ModDir)/lib/$(_Sts2GameVersion)</_ModLibDir>
      <_ModPck>$(MSBuildProjectDirectory)/$(MSBuildProjectName).pck</_ModPck>
      <_StaleLooseDir>$(_ModDir)/TheQueen</_StaleLooseDir>
    </PropertyGroup>

    <Message Text="Copying mod to $(_ModDir) and $(_ModLibDir)..." Importance="high" />
    <MakeDir Directories="$(_ModDir)/" />
    <MakeDir Directories="$(_ModLibDir)/" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(_ModLibDir)/TheQueen.dll" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFiles="$(_ModLibDir)/TheQueen.pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(_ModDir)/" />
    <Copy
      SourceFiles="$(_ModPck)"
      DestinationFolder="$(_ModDir)/"
      Condition="Exists('$(_ModPck)')"
      SkipUnchangedFiles="true" />
    <Warning
      Condition="!Exists('$(_ModPck)')"
      Text="TheQueen.pck not found at $(_ModPck). Export the PCK before testing in-game, or resources will be missing." />

    <!-- 清理旧版 PostBuild 误复制的 loose TheQueen/（含 localization/*.json） -->
    <RemoveDir Directories="$(_StaleLooseDir)" Condition="Exists('$(_StaleLooseDir)')" />
  </Target>
</Project>
